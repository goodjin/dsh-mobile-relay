{
  "name": "@goodjin2/dsh-mobile-relay",
  "version": "0.1.0",
  "description": "DSH plugin: cloud relay for mobile access — public entry, SSH tunnels, session/approval forwarding, mobile page",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodjin/dsh-mobile-relay.git"
  },
  "homepage": "https://github.com/goodjin/dsh-mobile-relay#readme",
  "bugs": {
    "url": "https://github.com/goodjin/dsh-mobile-relay/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "src/mobile/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "mobile",
    "relay",
    "ssh",
    "tailscale"
  ],
  "author": "goodjin",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@goodjin2/dsh-host-federation": "file:../threadharbor/packages/dsh-host-federation",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.10",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
